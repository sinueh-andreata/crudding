{{if .AppImport}}import { app } from "{{.AppImport}}.js";
{{else}}import "reflect-metadata";
import { Controller, Get, Module } from "@nestjs/common";
import { NestFactory } from "@nestjs/core";
import { getMessage } from "{{.ServiceImport}}.js";

class AppController {
  getMessage() {
    return { message: getMessage() };
  }
}

Controller()(AppController);
Get()(AppController.prototype, "getMessage", Object.getOwnPropertyDescriptor(AppController.prototype, "getMessage"){{if eq .Runtime "ts"}}!{{end}});

class AppModule {}
Module({ controllers: [AppController] })(AppModule);

const app = await NestFactory.create(AppModule);
{{end}}
await app.listen(Number(process.env.PORT ?? 3000));