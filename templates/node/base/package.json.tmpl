{
  "name": "{{.ProjectSlug}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
{{if eq .Runtime "ts"}}    "build": "tsc -p tsconfig.json",
    "start": "node dist/{{.CompiledEntry}}",
    "dev": "tsx watch {{.EntryScript}}",
{{else}}    "start": "node {{.EntryScript}}",
    "dev": "node --watch {{.EntryScript}}",
{{end}}    "test": "node --test"
  },
  "dependencies": {
{{if eq .Framework "express"}}    "express": "^5.1.0"
{{else if eq .Framework "fastify"}}    "fastify": "^5.4.0"
{{else if eq .Framework "nest"}}    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
{{else}}
{{end}}  },
  "devDependencies": {
{{if eq .Runtime "ts"}}    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
  "typescript": "^5.8.0"{{if eq .Framework "express"}},
  "@types/express": "^5.0.3"{{end}}
{{else if eq .Framework "nest"}}    "tsx": "^4.19.0"
{{else}}
{{end}}  }
}