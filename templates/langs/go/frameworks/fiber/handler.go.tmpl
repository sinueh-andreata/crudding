package {{if eq .Architecture "modular"}}{{.Package}}{{else if eq .Architecture "flat"}}main{{else}}handlers{{end}}

import (
	"strconv"

{{if eq .Architecture "layered"}}	"{{.GoModule}}/internal/service"
	"{{.GoModule}}/internal/types"
{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}	"{{.GoModule}}/internal/domain"
	"{{.GoModule}}/internal/ports"
{{end}}	"github.com/gofiber/fiber/v2"
)

type {{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}} struct {
	svc {{if eq .Architecture "layered"}}service.{{.Class}}Service{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}ports.{{.Class}}Service{{else if eq .Architecture "flat"}}{{.Class}}Service{{else}}Service{{end}}
}

func New{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}(svc {{if eq .Architecture "layered"}}service.{{.Class}}Service{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}ports.{{.Class}}Service{{else if eq .Architecture "flat"}}{{.Class}}Service{{else}}Service{{end}}) *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}} {
	return &{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}{svc: svc}
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) Create(c *fiber.Ctx) error {
	var req {{if eq .Architecture "layered"}}types.{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}domain.{{end}}Create{{.Class}}Request
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
	}

	res, err := h.svc.Create(req)
	if err != nil {
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "erro ao criar {{.VarName}}"})
	}

	return c.Status(fiber.StatusCreated).JSON(res)
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) List(c *fiber.Ctx) error {
	res, err := h.svc.List()
	if err != nil {
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "erro ao listar {{.VarName}}s"})
	}

	return c.JSON(res)
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) GetByID(c *fiber.Ctx) error {
	id, err := strconv.ParseUint(c.Params("id"), 10, 64)
	if err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "id inválido"})
	}

	res, err := h.svc.GetByID(uint(id))
	if err != nil {
		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": "{{.VarName}} não encontrado"})
	}

	return c.JSON(res)
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) Delete(c *fiber.Ctx) error {
	id, err := strconv.ParseUint(c.Params("id"), 10, 64)
	if err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "id inválido"})
	}

	if err := h.svc.Delete(uint(id)); err != nil {
		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": "{{.VarName}} não encontrado"})
	}

	return c.SendStatus(fiber.StatusNoContent)
}
