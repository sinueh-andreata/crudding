package {{if eq .Architecture "modular"}}{{.Package}}{{else if eq .Architecture "flat"}}main{{else}}handlers{{end}}

import (
	"encoding/json"
	"net/http"
	"strconv"

{{if eq .Architecture "layered"}}	"{{.GoModule}}/internal/service"
	"{{.GoModule}}/internal/types"
{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}	"{{.GoModule}}/internal/domain"
	"{{.GoModule}}/internal/ports"
{{end}})

type {{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}} struct {
	svc {{if eq .Architecture "layered"}}service.{{.Class}}Service{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}ports.{{.Class}}Service{{else if eq .Architecture "flat"}}{{.Class}}Service{{else}}Service{{end}}
}

func New{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}(svc {{if eq .Architecture "layered"}}service.{{.Class}}Service{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}ports.{{.Class}}Service{{else if eq .Architecture "flat"}}{{.Class}}Service{{else}}Service{{end}}) *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}} {
	return &{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}{svc: svc}
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) Create(w http.ResponseWriter, r *http.Request) {
	var req {{if eq .Architecture "layered"}}types.{{else if or (eq .Architecture "hexagonal") (eq .Architecture "clean_arch")}}domain.{{end}}Create{{.Class}}Request
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusBadRequest)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": err.Error()})
		return
	}

	res, err := h.svc.Create(req)
	if err != nil {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusInternalServerError)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "erro ao criar {{.VarName}}"})
		return
	}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusCreated)
	_ = json.NewEncoder(w).Encode(res)
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) List(w http.ResponseWriter, r *http.Request) {
	res, err := h.svc.List()
	if err != nil {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusInternalServerError)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "erro ao listar {{.VarName}}s"})
		return
	}

	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(res)
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) GetByID(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.ParseUint(r.PathValue("id"), 10, 64)
	if err != nil {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusBadRequest)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "id inválido"})
		return
	}

	res, err := h.svc.GetByID(uint(id))
	if err != nil {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusNotFound)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "{{.VarName}} não encontrado"})
		return
	}

	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(res)
}

func (h *{{if eq .Architecture "modular"}}Handler{{else}}{{.Class}}Handler{{end}}) Delete(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.ParseUint(r.PathValue("id"), 10, 64)
	if err != nil {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusBadRequest)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "id inválido"})
		return
	}

	if err := h.svc.Delete(uint(id)); err != nil {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusNotFound)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "{{.VarName}} não encontrado"})
		return
	}

	w.WriteHeader(http.StatusNoContent)
}
