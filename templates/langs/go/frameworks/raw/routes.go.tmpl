package {{if eq .Architecture "flat"}}main{{else}}routes{{end}}

import (
	"net/http"

{{if eq .Architecture "modular"}}	"{{.GoModule}}/internal/user"
{{else if eq .Architecture "layered"}}	"{{.GoModule}}/internal/handlers"
	"{{.GoModule}}/internal/service"
{{else if eq .Architecture "hexagonal"}}	"{{.GoModule}}/internal/adapters/postgres"
	"{{.GoModule}}/internal/application"
	"{{.GoModule}}/internal/handlers"
{{else if eq .Architecture "clean_arch"}}	"{{.GoModule}}/internal/application"
	"{{.GoModule}}/internal/handlers"
	"{{.GoModule}}/internal/infrastructure/persistence"
{{end}}	// crudding:imports
)

func SetupRouter() *http.ServeMux {
	mux := http.NewServeMux()

{{if eq .Architecture "modular"}}	userSvc := user.NewService()
	userHandler := user.NewHandler(userSvc)
{{else if eq .Architecture "layered"}}	userSvc := service.NewUserService()
	userHandler := handlers.NewUserHandler(userSvc)
{{else if eq .Architecture "hexagonal"}}	userRepo := postgres.NewUserRepository()
	userSvc := application.NewUserService(userRepo)
	userHandler := handlers.NewUserHandler(userSvc)
{{else if eq .Architecture "clean_arch"}}	userRepo := persistence.NewUserRepository()
	userSvc := application.NewUserService(userRepo)
	userHandler := handlers.NewUserHandler(userSvc)
{{else if eq .Architecture "flat"}}	userSvc := NewUserService()
	userHandler := NewUserHandler(userSvc)
{{end}}	mux.HandleFunc("POST /api/v1/users", userHandler.Create)
	mux.HandleFunc("GET /api/v1/users", userHandler.List)
	mux.HandleFunc("GET /api/v1/users/{id}", userHandler.GetByID)
	mux.HandleFunc("DELETE /api/v1/users/{id}", userHandler.Delete)
	// crudding:routes

	return mux
}
