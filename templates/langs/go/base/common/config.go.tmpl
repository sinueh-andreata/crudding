package config

import (
	"os"
{{- if .HasDatabase "postgres" }}
	"database/sql"
	"fmt"

	_ "github.com/lib/pq"
{{- end }}
{{- if .HasDatabase "mysql" }}
	"database/sql"
	"fmt"

	_ "github.com/go-sql-driver/mysql"
{{- end }}
{{- if .HasDatabase "mongo" }}
	"context"
	"fmt"
	"time"

	"go.mongodb.org/mongo-driver/mongo"
	"go.mongodb.org/mongo-driver/mongo/options"
{{- end }}
	// crudding:db-imports
)

type Config struct {
	Port string
	Env  string
{{- if .HasDatabase "postgres" }}
	Postgres PostgresConfig
{{- end }}
{{- if .HasDatabase "mysql" }}
	MySQL MySQLConfig
{{- end }}
{{- if .HasDatabase "mongo" }}
	Mongo MongoConfig
{{- end }}
	// crudding:db-struct
}

func Load() *Config {
	return &Config{
		Port: getEnv("PORT", "8080"),
		Env:  getEnv("APP_ENV", "development"),
{{- if .HasDatabase "postgres" }}
		Postgres: loadPostgresConfig(),
{{- end }}
{{- if .HasDatabase "mysql" }}
		MySQL: loadMySQLConfig(),
{{- end }}
{{- if .HasDatabase "mongo" }}
		Mongo: loadMongoConfig(),
{{- end }}
		// crudding:db-load
	}
}
{{- if .HasDatabase "postgres" }}

type PostgresConfig struct {
	URL string
}

func loadPostgresConfig() PostgresConfig {
	dsn := os.Getenv("DATABASE_URL")
	if dsn == "" {
		dsn = fmt.Sprintf(
			"host=%s port=%s user=%s password=%s dbname=%s sslmode=disable",
			getEnv("DB_HOST", "localhost"),
			getEnv("DB_PORT", "5432"),
			getEnv("DB_USER", "postgres"),
			getEnv("DB_PASSWORD", "postgres"),
			getEnv("DB_NAME", "app"),
		)
	}
	return PostgresConfig{URL: dsn}
}

// ConnectPostgres estabelece e valida a conexão com o PostgreSQL.
func ConnectPostgres(cfg PostgresConfig) (*sql.DB, error) {
	db, err := sql.Open("postgres", cfg.URL)
	if err != nil {
		return nil, fmt.Errorf("abrir conexão com postgres: %w", err)
	}
	if err := db.Ping(); err != nil {
		return nil, fmt.Errorf("ping no postgres: %w", err)
	}
	return db, nil
}
{{- end }}
{{- if .HasDatabase "mysql" }}

type MySQLConfig struct {
	DSN string
}

func loadMySQLConfig() MySQLConfig {
	dsn := os.Getenv("DATABASE_URL")
	if dsn == "" {
		dsn = fmt.Sprintf(
			"%s:%s@tcp(%s:%s)/%s?parseTime=true",
			getEnv("DB_USER", "user"),
			getEnv("DB_PASSWORD", "password"),
			getEnv("DB_HOST", "localhost"),
			getEnv("DB_PORT", "3306"),
			getEnv("DB_NAME", "app"),
		)
	}
	return MySQLConfig{DSN: dsn}
}

// ConnectMySQL estabelece e valida a conexão com o MySQL.
func ConnectMySQL(cfg MySQLConfig) (*sql.DB, error) {
	db, err := sql.Open("mysql", cfg.DSN)
	if err != nil {
		return nil, fmt.Errorf("abrir conexão com mysql: %w", err)
	}
	if err := db.Ping(); err != nil {
		return nil, fmt.Errorf("ping no mysql: %w", err)
	}
	return db, nil
}
{{- end }}
{{- if .HasDatabase "mongo" }}

type MongoConfig struct {
	URI    string
	DBName string
}

func loadMongoConfig() MongoConfig {
	uri := os.Getenv("MONGODB_URI")
	if uri == "" {
		uri = fmt.Sprintf(
			"mongodb://%s:%s@%s:%s/%s?authSource=admin",
			getEnv("DB_USER", "root"),
			getEnv("DB_PASSWORD", "rootpassword"),
			getEnv("DB_HOST", "localhost"),
			getEnv("DB_PORT", "27017"),
			getEnv("DB_NAME", "app"),
		)
	}
	return MongoConfig{
		URI:    uri,
		DBName: getEnv("DB_NAME", "app"),
	}
}

// ConnectMongo estabelece e valida a conexão com o MongoDB.
func ConnectMongo(ctx context.Context, cfg MongoConfig) (*mongo.Client, error) {
	client, err := mongo.Connect(ctx, options.Client().ApplyURI(cfg.URI))
	if err != nil {
		return nil, fmt.Errorf("abrir conexão com mongo: %w", err)
	}
	pingCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()
	if err := client.Ping(pingCtx, nil); err != nil {
		return nil, fmt.Errorf("ping no mongo: %w", err)
	}
	return client, nil
}
{{- end }}

// crudding:db-methods

func getEnv(key, fallback string) string {
	if val := os.Getenv(key); val != "" {
		return val
	}
	return fallback
}

