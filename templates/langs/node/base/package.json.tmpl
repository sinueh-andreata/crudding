{
  "name": "{{.ProjectSlug}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "{{if eq .Runtime "ts"}}tsx{{else}}node{{end}} {{.EntryScript}}",
    "dev": "{{if eq .Runtime "ts"}}tsx watch{{else}}node --watch{{end}} {{.EntryScript}}"{{if eq .Architecture "flat"}},
    "test": "{{if eq .Runtime "ts"}}tsx --test src/tasks.test.ts{{else}}node --test src/tasks.test.js{{end}}"{{end}}{{if eq .Runtime "ts"}},
    "typecheck": "tsc --noEmit"{{end}}
  },
  "dependencies": {
    {{if eq .Framework "express"}}"express": "^5.3.0"{{end}}{{if eq .Framework "fastify"}}"fastify": "^5.12.7"{{end}}{{if eq .Framework "nest"}}"@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"{{end}}
  },
  "devDependencies": {
    {{if eq .Runtime "ts"}}"@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"{{if or (eq .Framework "express") (eq .Framework "nest")}},
    "@types/express": "^5.0.6"{{end}}{{end}}
  }
}
