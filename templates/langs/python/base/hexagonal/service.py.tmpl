{{- if .HasORM "sqlalchemy" }}
from {{.Modules.model}} import {{.Class}}
from {{.Modules.port}} import {{.Class}}Repository
from {{.Modules.adapter}} import {{.Class}}RepositoryAdapter


def _to_dict(item: {{.Class}}) -> dict:
    return {"id": item.id}
{{- else }}
from dataclasses import asdict
from {{.Modules.model}} import {{.Class}}
from {{.Modules.port}} import {{.Class}}Repository
from {{.Modules.adapter}} import {{.Class}}RepositoryAdapter


def _to_dict(item: {{.Class}}) -> dict:
    return asdict(item)
{{- end }}


class {{.Class}}Service:
    def __init__(self, repository: {{.Class}}Repository):
        self.repository = repository

    def list_all(self) -> list[dict]:
        return [_to_dict(item) for item in self.repository.find_all()]

    def get(self, item_id: str) -> dict | None:
        item = self.repository.find_by_id(item_id)
        return _to_dict(item) if item is not None else None

    def create(self, payload: dict) -> dict:
{{- if .HasORM "sqlalchemy" }}
        item = {{.Class}}(id=payload.get("id"))
        return _to_dict(self.repository.save(item))
{{- else }}
        raise NotImplementedError
{{- end }}

    def update(self, item_id: str, payload: dict) -> dict:
{{- if .HasORM "sqlalchemy" }}
        item = self.repository.find_by_id(item_id)
        if not item:
            raise ValueError(f"{{.Class}} {item_id} não encontrado")
        return _to_dict(self.repository.save(item))
{{- else }}
        raise NotImplementedError
{{- end }}

    def delete(self, item_id: str) -> None:
        self.repository.delete(item_id)


_service = {{.Class}}Service({{.Class}}RepositoryAdapter())

list_all = _service.list_all
get = _service.get
create = _service.create
update = _service.update
delete = _service.delete

