{{- if .HasORM "sqlalchemy" }}
from {{.Modules.model}} import {{.Class}}
from {{.Modules.config}} import SessionLocal


def list_all() -> list[dict]:
    with SessionLocal() as db:
        items = db.query({{.Class}}).all()
        return [{"id": item.id} for item in items]


def get(item_id: str) -> dict | None:
    with SessionLocal() as db:
        item = db.query({{.Class}}).filter({{.Class}}.id == item_id).first()
        if not item:
            return None
        return {"id": item.id}


def create(payload: dict) -> dict:
    with SessionLocal() as db:
        item = {{.Class}}(id=payload.get("id"))
        db.add(item)
        db.commit()
        db.refresh(item)
        return {"id": item.id}


def update(item_id: str, payload: dict) -> dict:
    with SessionLocal() as db:
        item = db.query({{.Class}}).filter({{.Class}}.id == item_id).first()
        if not item:
            raise ValueError(f"{{.Class}} {item_id} não encontrado")
        # TODO: atualize os campos de item a partir de payload
        db.commit()
        db.refresh(item)
        return {"id": item.id}


def delete(item_id: str) -> None:
    with SessionLocal() as db:
        item = db.query({{.Class}}).filter({{.Class}}.id == item_id).first()
        if item:
            db.delete(item)
            db.commit()
