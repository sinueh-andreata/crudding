{{- if .HasORM "sqlalchemy" }}
from {{.Modules.model}} import {{.Class}}


def present_{{.Name}}(item: {{.Class}}) -> dict:
    return {"id": item.id}
{{- else }}
from dataclasses import asdict

from {{.Modules.model}} import {{.Class}}


def present_{{.Name}}(item: {{.Class}}) -> dict:
    return asdict(item)
{{- end }}

