from {{.Package}}.application.use_cases.create_{{.Name}} import Create{{.Class}}
from {{.Package}}.application.use_cases.delete_{{.Name}} import Delete{{.Class}}
from {{.Package}}.application.use_cases.get_{{.Name}} import Get{{.Class}}
from {{.Package}}.application.use_cases.list_{{.Name}} import List{{.Class}}
from {{.Package}}.application.use_cases.update_{{.Name}} import Update{{.Class}}
from {{.Package}}.interface_adapters.controllers.{{.Name}}_controller import {{.Class}}Controller
from {{.Package}}.interface_adapters.persistence.{{.Name}}_repository import {{.Class}}RepositoryAdapter


def _build_controller() -> {{.Class}}Controller:
    repository = {{.Class}}RepositoryAdapter()
    return {{.Class}}Controller({
        "create": Create{{.Class}}(repository),
        "get": Get{{.Class}}(repository),
        "list": List{{.Class}}(repository),
        "update": Update{{.Class}}(repository),
        "delete": Delete{{.Class}}(repository),
    })


handler = _build_controller()


def route(method: str, parts: list[str], body=None, query=None) -> dict:
    payload = body if isinstance(body, dict) else {}
    try:
        if not parts:
            if method == "GET":
                return {"status": 200, "body": handler.list_all()}
            if method == "POST":
                return {"status": 201, "body": handler.create(payload)}
        elif len(parts) == 1:
            item_id = parts[0]
            if method == "GET":
                item = handler.get(item_id)
                if item is None:
                    return {"status": 404, "body": {"error": f"{{.Route}} {item_id} not found"}}
                return {"status": 200, "body": item}
            if method == "PATCH":
                return {"status": 200, "body": handler.update(item_id, payload)}
            if method == "DELETE":
                handler.delete(item_id)
                return {"status": 204}
        return {"status": 404, "body": {"error": "route not found"}}
    except NotImplementedError:
        return {"status": 501, "body": {"error": "{{.Route}}: not implemented"}}
