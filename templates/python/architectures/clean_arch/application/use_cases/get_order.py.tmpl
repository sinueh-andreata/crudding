from src.app.domain.exceptions import OrderNotFound
from src.app.application.use_cases.order_output import to_order_output


class GetOrder:
    def __init__(self, orders):
        self.orders = orders

    def execute(self, order_id: str) -> dict:
        order = self.orders.find_by_id(order_id)
        if order is None:
            raise OrderNotFound(order_id)
        return to_order_output(order)