from src.app.domain.model.order import Order


def to_order_output(order: Order) -> dict:
    return {
        "id": order.id,
        "customerId": order.customer_id,
        "items": [dict(item) for item in order.items],
        "total": order.total,
        "status": order.status,
        "createdAt": order.created_at,
    }