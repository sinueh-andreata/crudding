from uuid import uuid4

from src.app.domain.model.order import Order
from src.app.application.use_cases.order_output import to_order_output


class CreateOrder:
    def __init__(self, orders):
        self.orders = orders

    def execute(self, customer_id: str, items: list[dict]) -> dict:
        order = Order.create(uuid4().hex, customer_id, items)
        self.orders.save(order)
        return to_order_output(order)