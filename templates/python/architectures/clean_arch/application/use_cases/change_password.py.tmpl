from src.app.application.port.outbound.register_user_port import RegisterUserPort
from src.app.domain.exceptions import UserNotFound


class ChangePassword:
    def __init__(self, users: RegisterUserPort):
        self.users = users

    def execute(self, user_id: str, new_password_hash: str) -> None:
        user = self.users.get(user_id)
        if user is None:
            raise UserNotFound(user_id)
        user.password_hash = new_password_hash
        self.users.save(user)