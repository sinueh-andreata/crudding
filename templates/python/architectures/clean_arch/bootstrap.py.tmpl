from src.app.application.use_cases.create_order import CreateOrder
from src.app.application.use_cases.get_order import GetOrder
from src.app.application.use_cases.list_orders import ListOrders
from src.app.application.use_cases.pay_order import PayOrder
from src.app.interface_adapters.controllers.order_controller import OrderController
from src.app.interface_adapters.persistence.order_repository import InMemoryOrderRepository


def build_order_controller() -> OrderController:
    repository = InMemoryOrderRepository()
    return OrderController({
        "create": CreateOrder(repository),
        "get": GetOrder(repository),
        "list": ListOrders(repository),
        "pay": PayOrder(repository),
    })