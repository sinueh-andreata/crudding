from dataclasses import dataclass, field
from datetime import datetime, timezone
import math

from src.app.domain.exceptions import InvalidOrder, OrderStateError


@dataclass
class Order:
    id: str
    customer_id: str
    items: list[dict]
    status: str = "pending"
    created_at: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"))

    @classmethod
    def create(cls, order_id: str, customer_id: str, items: list[dict]) -> "Order":
        if not customer_id.strip():
            raise InvalidOrder("customerId is required")
        if not items:
            raise InvalidOrder("order must contain at least one item")
        normalized = []
        for item in items:
            sku = str(item.get("sku", "")).strip()
            quantity = item.get("quantity")
            unit_price = item.get("unitPrice")
            if (
                not sku
                or not isinstance(quantity, int)
                or quantity <= 0
                or not isinstance(unit_price, (int, float))
                or not math.isfinite(unit_price)
                or unit_price <= 0
            ):
                raise InvalidOrder("order item is invalid")
            normalized.append({"sku": sku, "quantity": quantity, "unitPrice": float(unit_price)})
        return cls(id=order_id, customer_id=customer_id.strip(), items=normalized)

    @property
    def total(self) -> float:
        amount = sum(item["quantity"] * item["unitPrice"] for item in self.items)
        return int(amount * 100 + 0.5) / 100

    def pay(self) -> None:
        if self.status != "pending":
            raise OrderStateError(f"order {self.id} is {self.status} and cannot be paid")
        self.status = "paid"

    def cancel(self) -> None:
        if self.status == "paid":
            raise OrderStateError(f"order {self.id} is paid and cannot be cancelled")
        self.status = "cancelled"


def order_snapshot(order: Order) -> dict:
    return {
        "id": order.id,
        "customer_id": order.customer_id,
        "items": [dict(item) for item in order.items],
        "status": order.status,
        "created_at": order.created_at,
    }