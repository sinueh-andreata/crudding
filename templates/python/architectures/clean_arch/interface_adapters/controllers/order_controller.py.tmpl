from src.app.interface_adapters.presenters.order_presenter import present_order


class OrderController:
    def __init__(self, use_cases):
        self.use_cases = use_cases

    def list(self) -> list[dict]:
        return [present_order(order) for order in self.use_cases["list"].execute()]

    def get(self, order_id: str) -> dict:
        return present_order(self.use_cases["get"].execute(order_id))

    def create(self, payload: dict) -> dict:
        raw_items = payload.get("items")
        items = []
        if isinstance(raw_items, list):
            for raw in raw_items:
                item = raw if isinstance(raw, dict) else {}
                try:
                    quantity_value = float(item.get("quantity"))
                    unit_price = float(item.get("unitPrice"))
                except (TypeError, ValueError):
                    quantity_value, unit_price = 0, 0
                quantity = int(quantity_value) if quantity_value.is_integer() else 0
                items.append({"sku": str(item.get("sku", "")), "quantity": quantity, "unitPrice": unit_price})
        order = self.use_cases["create"].execute(str(payload.get("customerId", "")), items)
        return present_order(order)

    def pay(self, order_id: str) -> dict:
        return present_order(self.use_cases["pay"].execute(order_id))