from dataclasses import asdict

from {{.Package}}.application.{{.Name}}_service import {{.Class}}Service
from {{.Package}}.infrastructure.{{.Name}}_repository import {{.Class}}RepositoryAdapter

_service = {{.Class}}Service({{.Class}}RepositoryAdapter())


def list_all() -> list[dict]:
    return [asdict(item) for item in _service.list()]


def get(item_id: str) -> dict | None:
    item = _service.get(item_id)
    return asdict(item) if item is not None else None


def create(payload: dict) -> dict:
    return asdict(_service.create(payload))


def update(item_id: str, payload: dict) -> dict:
    return asdict(_service.update(item_id, payload))


def delete(item_id: str) -> None:
    _service.delete(item_id)
