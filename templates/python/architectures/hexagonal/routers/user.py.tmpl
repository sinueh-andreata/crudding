from src.app.application.user_service import UserService


def create_user(service: UserService, payload: dict) -> dict:
    user = service.register(payload["id"], payload["name"], payload["email"])
    return {"id": user.id, "name": user.name, "email": user.email}


def get_user(service: UserService, user_id: str) -> dict | None:
    user = service.find(user_id)
    if user is None:
        return None
    return {"id": user.id, "name": user.name, "email": user.email}