from src.app.application.product_service import ProductService


def create_product(service: ProductService, payload: dict) -> dict:
    price = float(payload.get("price"))
    stock_value = float(payload.get("stock", 0))
    if not stock_value.is_integer():
        raise ValueError("stock must be an integer")
    product = service.create(str(payload.get("name", "")), price, int(stock_value))
    return present_product(product)


def get_product(service: ProductService, product_id: str) -> dict | None:
    return present_product(service.get(product_id))


def list_products(service: ProductService) -> list[dict]:
    return [present_product(product) for product in service.list()]


def apply_product_discount(service: ProductService, product_id: str, payload: dict) -> dict:
    product = service.apply_discount(product_id, float(payload.get("percent")))
    return present_product(product)


def present_product(product) -> dict:
    return {"id": product.id, "name": product.name, "price": product.price, "stock": product.stock}