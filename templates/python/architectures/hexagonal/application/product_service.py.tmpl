from uuid import uuid4

from src.app.domain.entities import Product, apply_discount
from src.app.domain.exceptions import ProductNotFoundError


class ProductService:
    def __init__(self, repository):
        self.repository = repository

    def list(self) -> list[Product]:
        return self.repository.find_all()

    def get(self, product_id: str) -> Product:
        product = self.repository.find_by_id(product_id)
        if product is None:
            raise ProductNotFoundError(product_id)
        return product

    def create(self, name: str, price: float, stock: int = 0) -> Product:
        product = Product(id=uuid4().hex, name=name, price=price, stock=stock)
        return self.repository.save(product)

    def apply_discount(self, product_id: str, percent: float) -> Product:
        product = apply_discount(self.get(product_id), percent)
        return self.repository.save(product)