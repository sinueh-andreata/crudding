from dataclasses import dataclass
import math


@dataclass
class Product:
    id: int
    sku: str
    name: str
    price: float
    stock: int


def parse_new_product(payload: dict) -> tuple[str, str, float, int]:
    sku = str(payload.get("sku", "")).strip().upper()
    name = str(payload.get("name", "")).strip()
    try:
        price = float(payload.get("price"))
        raw_stock = payload.get("stock", 0)
        stock_value = float(raw_stock)
    except (TypeError, ValueError):
        raise ValueError("price and stock must be numbers") from None
    if not math.isfinite(price) or price <= 0 or not math.isfinite(stock_value) or not stock_value.is_integer():
        raise ValueError("price must be positive and stock must be an integer")
    stock = int(stock_value)
    if not sku or not name or stock < 0:
        raise ValueError("sku and name are required; stock must be non-negative")
    return sku, name, price, stock