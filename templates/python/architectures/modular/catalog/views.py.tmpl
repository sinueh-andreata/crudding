from src.app.catalog.service import get_product, list_products


def product_detail(product_id: int) -> dict | None:
    product = get_product(product_id)
    if product is None:
        return None
    return {"id": product.id, "name": product.name, "price": product.price, "stock": product.stock}


def product_list() -> list[dict]:
    return [
        {"id": product.id, "name": product.name, "price": product.price, "stock": product.stock}
        for product in list_products()
    ]