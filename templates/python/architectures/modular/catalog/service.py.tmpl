from src.app.catalog.models import Product

_products: dict[int, Product] = {
    1: Product(id=1, name="Notebook", price=1200.0, stock=8),
    2: Product(id=2, name="Mouse", price=35.0, stock=20),
}


def get_message() -> str:
    return "Catalog service is running"


def list_products() -> list[Product]:
    return list(_products.values())


def get_product(product_id: int) -> Product | None:
    return _products.get(product_id)


def add_product(name: str, price: float, stock: int) -> Product:
    if price < 0 or stock < 0:
        raise ValueError("price and stock must be non-negative")
    product_id = max(_products, default=0) + 1
    product = Product(id=product_id, name=name, price=price, stock=stock)
    _products[product.id] = product
    return product