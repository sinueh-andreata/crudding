from src.app.catalog.models import Product
from src.app.shared.errors import ConflictError, NotFoundError

_products: dict[int, Product] = {
    1: Product(id=1, sku="KB-01", name="Teclado Mecânico", price=450.0, stock=10),
    2: Product(id=2, sku="MS-01", name="Mouse Ergonômico", price=189.9, stock=25),
}


def list_products() -> list[Product]:
    return list(_products.values())


def get_product(product_id: int) -> Product | None:
    return _products.get(product_id)


def add_product(sku: str, name: str, price: float, stock: int) -> Product:
    if any(product.sku == sku for product in _products.values()):
        raise ConflictError(f"sku {sku} already registered")
    product_id = max(_products, default=0) + 1
    product = Product(id=product_id, sku=sku, name=name, price=price, stock=stock)
    _products[product.id] = product
    return product


def require_product(product_id: int) -> Product:
    product = get_product(product_id)
    if product is None:
        raise NotFoundError(f"product {product_id} not found")
    return product


def reserve(product_id: int, quantity: int) -> Product:
    product = require_product(product_id)
    if product.stock < quantity:
        raise ConflictError(f"insufficient stock for {product.sku}")
    product.stock -= quantity
    return product