from datetime import datetime, timezone

from src.app.catalog.service import require_product, reserve
from src.app.orders.models import Order
from src.app.shared.errors import NotFoundError

_orders: dict[int, Order] = {}


def place_order(items: list[dict]) -> Order:
    if not items:
        raise ValueError("order must contain at least one item")
    for item in items:
        require_product(item["product_id"])
    lines = []
    for item in items:
        product = reserve(item["product_id"], item["quantity"])
        lines.append({"product_id": product.id, "name": product.name, "quantity": item["quantity"], "unit_price": product.price})
    total = int(sum(line["quantity"] * line["unit_price"] for line in lines) * 100 + 0.5) / 100
    order_id = max(_orders, default=0) + 1
    order = Order(
        id=order_id,
        lines=lines,
        total=total,
        created_at=datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
    )
    _orders[order.id] = order
    return order


def list_orders() -> list[Order]:
    return list(_orders.values())


def get_order(order_id: int) -> Order:
    order = _orders.get(order_id)
    if order is None:
        raise NotFoundError(f"order {order_id} not found")
    return order