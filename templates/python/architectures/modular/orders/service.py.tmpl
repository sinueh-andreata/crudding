from src.app.checkout.service import complete_checkout
from src.app.orders.models import Order

_orders: dict[int, Order] = {}


def place_order(checkout_id: int) -> Order:
    checkout = complete_checkout(checkout_id)
    order_id = max(_orders, default=0) + 1
    order = Order(id=order_id, checkout_id=checkout.id, status="paid")
    _orders[order.id] = order
    return order


def list_orders() -> list[Order]:
    return list(_orders.values())