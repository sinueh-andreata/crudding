from src.app.models.order import Order
from src.app.models.errors import ConflictError, NotFoundError
from src.app.services import user_service

_orders: dict[int, Order] = {}
_next_order_id = 1


def create_order(user_id: int, items: list[dict]) -> Order:
    global _next_order_id
    user_service.require_user(user_id)
    total = int(sum(item["quantity"] * item["unit_price"] for item in items) * 100 + 0.5) / 100
    order = Order(id=_next_order_id, user_id=user_id, total=total, items=items)
    _orders[order.id] = order
    _next_order_id += 1
    return order


def get_order(order_id: int) -> Order | None:
    return _orders.get(order_id)


def list_orders() -> list[Order]:
    return list(_orders.values())


def require_order(order_id: int) -> Order:
    order = get_order(order_id)
    if order is None:
        raise NotFoundError(f"order {order_id} not found")
    return order


def list_user_orders(user_id: int | None = None) -> list[Order]:
    orders = list_orders()
    return orders if user_id is None else [order for order in orders if order.user_id == user_id]


def pay_order(order_id: int) -> Order:
    order = require_order(order_id)
    if order.status != "pending":
        raise ConflictError(f"order {order_id} is {order.status} and cannot be paid")
    order.status = "paid"
    return order


def cancel_order(order_id: int) -> Order:
    order = require_order(order_id)
    if order.status == "paid":
        raise ConflictError(f"order {order_id} is paid and cannot be cancelled")
    order.status = "cancelled"
    return order