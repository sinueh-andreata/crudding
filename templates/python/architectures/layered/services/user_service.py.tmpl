from src.app.models.user import User
from src.app.models.errors import ConflictError, NotFoundError

_users: dict[int, User] = {}
_next_user_id = 1


def create_user(name: str, email: str) -> User:
    global _next_user_id
    if any(user.email == email for user in _users.values()):
        raise ConflictError(f"email {email} already registered")
    user = User(id=_next_user_id, name=name, email=email)
    _users[user.id] = user
    _next_user_id += 1
    return user


def get_user(user_id: int) -> User | None:
    return _users.get(user_id)


def require_user(user_id: int) -> User:
    user = get_user(user_id)
    if user is None:
        raise NotFoundError(f"user {user_id} not found")
    return user


def list_users() -> list[User]:
    return list(_users.values())