from dataclasses import asdict

from {{.Package}}.services import {{.Name}}_service


def list_all() -> list[dict]:
    return [asdict(item) for item in {{.Name}}_service.list_all()]


def get(item_id: str) -> dict | None:
    item = {{.Name}}_service.get(item_id)
    return asdict(item) if item is not None else None


def create(payload: dict) -> dict:
    return asdict({{.Name}}_service.create(payload))


def update(item_id: str, payload: dict) -> dict:
    return asdict({{.Name}}_service.update(item_id, payload))


def delete(item_id: str) -> None:
    {{.Name}}_service.delete(item_id)
