from src.app.models.order import Order, parse_new_order
from src.app.services import order_service


def create_order(payload: dict) -> Order:
    user_id, items = parse_new_order(payload)
    return order_service.create_order(user_id=user_id, items=items)


def get_order(order_id: int) -> Order | None:
    return order_service.get_order(order_id)


def list_orders() -> list[Order]:
    return order_service.list_orders()