[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "{{.ProjectName}}"
version = "0.1.0"
description = "Projeto Python gerado pelo crudding"
requires-python = ">=3.10"
dependencies = [
{{range .Dependencies}}    "{{.}}",
{{end}}]

[tool.setuptools.packages.find]
where = ["src"]