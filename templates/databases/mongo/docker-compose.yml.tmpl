services:
  mongo:
    image: mongo:7.0
    container_name: {{.ProjectSlug}}-mongo
    restart: unless-stopped
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${DB_USER:-root}
      MONGO_INITDB_ROOT_PASSWORD: ${DB_PASSWORD:-rootpassword}
    ports:
      - "${DB_PORT:-27017}:27017"
    volumes:
      - mongo_data:/data/db
  # crudding:compose-services

volumes:
  mongo_data:
  # crudding:compose-volumes
