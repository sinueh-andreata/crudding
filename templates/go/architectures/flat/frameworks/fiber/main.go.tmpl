package main

import (
	"github.com/gofiber/fiber/v2"
)

func main() {
	app := fiber.New()

	app.Get("/", func(c *fiber.Ctx) error {
		item, _ := ParseInput("crudding flat")
		report := GenerateReport(item)

		return c.JSON(fiber.Map{
			"message": "Hello from Flat Architecture (Fiber)",
			"item":    item,
			"report":  report,
		})
	})

	_ = app.Listen(":8080")
}

