package main

import "testing"

func TestParseInput(t *testing.T) {
	item, err := ParseInput("crudding")
	if err != nil {
		t.Fatalf("ParseInput() erro inesperado: %v", err)
	}
	if item.Name != "crudding" || item.Value != 8 {
		t.Fatalf("ParseInput() retornou dados inválidos: %+v", item)
	}

	if _, err := ParseInput("   "); err == nil {
		t.Fatal("ParseInput() deveria falhar para strings em branco")
	}
}

