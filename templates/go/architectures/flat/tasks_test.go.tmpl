package main

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

func TestTaskLifecycle(t *testing.T) {
	handler := NewTaskHandler()
	created := httptest.NewRecorder()
	handler.ServeHTTP(created, httptest.NewRequest(http.MethodPost, "/tasks", strings.NewReader(`{"title":"write tests"}`)))
	if created.Code != http.StatusCreated || !strings.Contains(created.Body.String(), `"done":false`) {
		t.Fatalf("create response = %d %s", created.Code, created.Body.String())
	}
	completed := httptest.NewRecorder()
	handler.ServeHTTP(completed, httptest.NewRequest(http.MethodPatch, "/tasks/2/done", nil))
	if completed.Code != http.StatusOK || !strings.Contains(completed.Body.String(), `"done":true`) {
		t.Fatalf("complete response = %d %s", completed.Code, completed.Body.String())
	}
	removed := httptest.NewRecorder()
	handler.ServeHTTP(removed, httptest.NewRequest(http.MethodDelete, "/tasks/2", nil))
	if removed.Code != http.StatusNoContent {
		t.Fatalf("delete status = %d", removed.Code)
	}
}

func TestCreateTaskRequiresTitle(t *testing.T) {
	response := httptest.NewRecorder()
	NewTaskHandler().ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/tasks", strings.NewReader(`{}`)))
	if response.Code != http.StatusBadRequest {
		t.Fatalf("status = %d, want %d", response.Code, http.StatusBadRequest)
	}
}