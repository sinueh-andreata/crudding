package main

import (
	"errors"
	"strings"
)

// Item representa uma entidade processada pelo parser.
type Item struct {
	Name  string `json:"name"`
	Value int    `json:"value"`
}

// ParseInput realiza a validação e conversão de dados de entrada.
func ParseInput(raw string) (*Item, error) {
	trimmed := strings.TrimSpace(raw)
	if trimmed == "" {
		return nil, errors.New("entrada vazia informada")
	}
	return &Item{
		Name:  trimmed,
		Value: len(trimmed),
	}, nil
}

