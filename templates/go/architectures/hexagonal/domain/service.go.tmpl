package application

import (
	"fmt"

	"{{.GoModule}}/internal/domain"
	"{{.GoModule}}/internal/ports"
)

// Service implementa a lógica do core domain e satisfaz a porta ports.ProductService.
type Service struct {
	repo ports.ProductRepository
}

// NewService instancia o serviço injetando o repositório contratado via porta.
func NewService(repo ports.ProductRepository) *Service {
	return &Service{repo: repo}
}

// ListProducts obtém os produtos através da Driven Port do repositório.
func (s *Service) ListProducts() ([]domain.Product, error) {
	return s.repo.FindAll()
}

func (s *Service) GetProduct(id string) (domain.Product, error) {
	product, ok := s.repo.FindByID(id)
	if !ok {
		return domain.Product{}, domain.ErrProductNotFound
	}
	return product, nil
}

func (s *Service) CreateProduct(name string, price float64, stock int) (domain.Product, error) {
	products, err := s.repo.FindAll()
	if err != nil {
		return domain.Product{}, err
	}
	product, err := domain.NewProduct(fmt.Sprintf("prod-%d", len(products)+1), name, price, stock)
	if err != nil {
		return domain.Product{}, err
	}
	if err := s.repo.Save(product); err != nil {
		return domain.Product{}, err
	}
	return product, nil
}

func (s *Service) ApplyDiscount(id string, percent float64) (domain.Product, error) {
	product, err := s.GetProduct(id)
	if err != nil {
		return domain.Product{}, err
	}
	product, err = product.Discount(percent)
	if err != nil {
		return domain.Product{}, err
	}
	if err := s.repo.Save(product); err != nil {
		return domain.Product{}, err
	}
	return product, nil
}

