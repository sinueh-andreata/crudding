package grpc

import (
	"log"

	"{{.GoModule}}/internal/ports"
)

// Server é o Driving Adapter que expõe as capacidades de negócio via protocolo gRPC.
type Server struct {
	service ports.ProductService
}

// NewServer inicializa o adaptador gRPC injetando a porta primária.
func NewServer(service ports.ProductService) *Server {
	return &Server{service: service}
}

// Start inicializa o listener gRPC.
func (s *Server) Start() {
	products, _ := s.service.ListProducts()
	log.Printf("[gRPC Adapter] Servidor gRPC ativo na porta :50051 (carregados %d produtos do domínio)", len(products))
}

