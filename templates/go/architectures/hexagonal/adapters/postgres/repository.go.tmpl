package postgres

import (
	"sync"

	"{{.GoModule}}/internal/domain"
)

// Repository é o Driven Adapter que implementa a porta ports.ProductRepository.
type Repository struct {
	mu       sync.RWMutex
	products []domain.Product
}

// New instancia o adaptador de persistência PostgreSQL (simulado em memória).
func New() *Repository {
	return &Repository{
		products: []domain.Product{
			{ID: "prod-1", Name: "Mouse Ergonômico", Price: 189.90},
			{ID: "prod-2", Name: "Teclado Mecânico RGB", Price: 450.00},
			{ID: "prod-3", Name: "Headset 7.1 Surround", Price: 320.00},
		},
	}
}

// FindAll retorna os produtos persistidos.
func (r *Repository) FindAll() ([]domain.Product, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	copied := make([]domain.Product, len(r.products))
	copy(copied, r.products)
	return copied, nil
}

