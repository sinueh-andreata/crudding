package main

import (
	"github.com/gin-gonic/gin"

	httpAdapter "{{.GoModule}}/internal/adapters/http"
	"{{.GoModule}}/internal/adapters/postgres"
	"{{.GoModule}}/internal/domain"
)

func main() {
	repo := postgres.New()
	service := domain.NewService(repo)
	handler := httpAdapter.NewHandler(service)

	router := gin.Default()

	router.GET("/products", func(c *gin.Context) {
		products, err := handler.GetProducts()
		if err != nil {
			c.JSON(500, gin.H{"error": err.Error()})
			return
		}

		c.JSON(200, gin.H{
			"message":  "Hello from Hexagonal Architecture (Gin)",
			"products": products,
		})
	})

	_ = router.Run(":8080")
}

