package main

import (
	"encoding/json"
	"log"
	"net/http"

	httpAdapter "{{.GoModule}}/internal/adapters/http"
	"{{.GoModule}}/internal/adapters/postgres"
	"{{.GoModule}}/internal/domain"
)

func main() {
	// Composition Root: montagem das dependências através de portas e adaptadores
	repo := postgres.New()                 // Driven Adapter
	service := domain.NewService(repo)     // Core Domain Service
	handler := httpAdapter.NewHandler(service) // Driving Adapter

	http.HandleFunc("/products", func(w http.ResponseWriter, _ *http.Request) {
		products, err := handler.GetProducts()
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}

		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]any{
			"message":  "Hello from Hexagonal Architecture (Standard net/http)",
			"products": products,
		})
	})

	log.Println("REST Adapter rodando em http://localhost:8080/products")
	log.Fatal(http.ListenAndServe(":8080", nil))
}

