package main

import (
	"encoding/json"
	"log"
	"net/http"

	"github.com/go-chi/chi/v5"

	httpAdapter "{{.GoModule}}/internal/adapters/http"
	"{{.GoModule}}/internal/adapters/postgres"
	"{{.GoModule}}/internal/domain"
)

func main() {
	repo := postgres.New()
	service := domain.NewService(repo)
	handler := httpAdapter.NewHandler(service)

	router := chi.NewRouter()

	router.Get("/products", func(w http.ResponseWriter, _ *http.Request) {
		products, err := handler.GetProducts()
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}

		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]any{
			"message":  "Hello from Hexagonal Architecture (Chi)",
			"products": products,
		})
	})

	log.Println("REST Adapter rodando em http://localhost:8080/products")
	log.Fatal(http.ListenAndServe(":8080", router))
}

