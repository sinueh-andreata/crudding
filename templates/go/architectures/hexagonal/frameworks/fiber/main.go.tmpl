package main

import (
	"github.com/gofiber/fiber/v2"

	httpAdapter "{{.GoModule}}/internal/adapters/http"
	"{{.GoModule}}/internal/adapters/postgres"
	"{{.GoModule}}/internal/domain"
)

func main() {
	repo := postgres.New()
	service := domain.NewService(repo)
	handler := httpAdapter.NewHandler(service)

	app := fiber.New()

	app.Get("/products", func(c *fiber.Ctx) error {
		products, err := handler.GetProducts()
		if err != nil {
			return c.Status(500).JSON(fiber.Map{"error": err.Error()})
		}

		return c.JSON(fiber.Map{
			"message":  "Hello from Hexagonal Architecture (Fiber)",
			"products": products,
		})
	})

	_ = app.Listen(":8080")
}

