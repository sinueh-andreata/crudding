package user

import (
	"sync"
)

// Handler provê o ponto de integração para operações com usuários.
type Handler struct {
	mu    sync.RWMutex
	users []User
}

// NewHandler cria uma nova instância do handler de usuário com dados iniciais.
func NewHandler() *Handler {
	return &Handler{
		users: []User{
			{ID: "usr-1", Name: "Ana Silva", Email: "ana.silva@example.com"},
			{ID: "usr-2", Name: "Carlos Souza", Email: "carlos.souza@example.com"},
		},
	}
}

// Users retorna a listagem de usuários.
func (h *Handler) Users() []User {
	h.mu.RLock()
	defer h.mu.RUnlock()
	copied := make([]User, len(h.users))
	copy(copied, h.users)
	return copied
}
