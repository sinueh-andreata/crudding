package user

import (
	"sync"
)

// Repository gerencia a persistência dos usuários.
type Repository struct {
	mu    sync.RWMutex
	users []User
}

// NewRepository cria uma instância do repositório de usuários.
func NewRepository() *Repository {
	return &Repository{
		users: []User{
			{ID: "usr-1", Name: "Ana Silva", Email: "ana.silva@example.com"},
			{ID: "usr-2", Name: "Carlos Souza", Email: "carlos.souza@example.com"},
		},
	}
}

// List retorna todos os usuários cadastrados.
func (r *Repository) List() []User {
	r.mu.RLock()
	defer r.mu.RUnlock()
	copied := make([]User, len(r.users))
	copy(copied, r.users)
	return copied
}

