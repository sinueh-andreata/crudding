package router

import (
	"github.com/gin-gonic/gin"

	"{{.GoModule}}/internal/order"
	"{{.GoModule}}/internal/platform/database"
	"{{.GoModule}}/internal/user"
)

// Setup conecta módulos, inicializa a plataforma e registra todas as rotas utilizando Gin.
func Setup() *gin.Engine {
	_ = database.Connect()

	orderService := order.NewService()
	orderHandler := order.NewHandler(orderService)
	userHandler := user.NewHandler()

	r := gin.Default()

	r.GET("/orders", func(c *gin.Context) {
		c.JSON(200, gin.H{
			"module": "order",
			"orders": orderHandler.Orders(),
		})
	})

	r.GET("/users", func(c *gin.Context) {
		c.JSON(200, gin.H{
			"module": "user",
			"users":  userHandler.Users(),
		})
	})

	return r
}

