package router

import (
	"github.com/gofiber/fiber/v2"

	"{{.GoModule}}/internal/order"
	"{{.GoModule}}/internal/platform/database"
	"{{.GoModule}}/internal/user"
)

// Setup conecta módulos, inicializa a plataforma e registra todas as rotas utilizando Fiber.
func Setup() *fiber.App {
	_ = database.Connect()

	orderService := order.NewService()
	orderHandler := order.NewHandler(orderService)
	userHandler := user.NewHandler()

	app := fiber.New()

	app.Get("/orders", func(c *fiber.Ctx) error {
		return c.JSON(fiber.Map{
			"module": "order",
			"orders": orderHandler.Orders(),
		})
	})

	app.Get("/users", func(c *fiber.Ctx) error {
		return c.JSON(fiber.Map{
			"module": "user",
			"users":  userHandler.Users(),
		})
	})

	return app
}

