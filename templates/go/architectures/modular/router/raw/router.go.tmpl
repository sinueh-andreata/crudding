package router

import (
	"encoding/json"
	"net/http"

	"{{.GoModule}}/internal/order"
	"{{.GoModule}}/internal/platform/database"
	"{{.GoModule}}/internal/user"
)

// Setup conecta módulos, inicializa a plataforma e registra todas as rotas da aplicação.
func Setup() http.Handler {
	_ = database.Connect()

	orderService := order.NewService()
	orderHandler := order.NewHandler(orderService)
	userHandler := user.NewHandler()

	mux := http.NewServeMux()

	mux.HandleFunc("/orders", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]any{
			"module": "order",
			"orders": orderHandler.Orders(),
		})
	})

	mux.HandleFunc("/users", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]any{
			"module": "user",
			"users":  userHandler.Users(),
		})
	})

	return mux
}

