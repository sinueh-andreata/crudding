package order

import (
	"errors"
	"math"
	"sort"
	"sync"
	"time"

	"{{.GoModule}}/internal/product"
)

type Service struct {
	mu      sync.RWMutex
	orders  map[int]Order
	nextID  int
	catalog *product.Service
}

func NewService(catalog *product.Service) *Service {
	return &Service{orders: make(map[int]Order), nextID: 1, catalog: catalog}
}

func (s *Service) GetOrders() []Order {
	s.mu.RLock()
	defer s.mu.RUnlock()
	orders := make([]Order, 0, len(s.orders))
	for _, order := range s.orders { orders = append(orders, order) }
	sort.Slice(orders, func(i, j int) bool { return orders[i].ID < orders[j].ID })
	return orders
}

func (s *Service) GetOrder(id int) (Order, bool) {
	s.mu.RLock(); defer s.mu.RUnlock()
	order, ok := s.orders[id]
	return order, ok
}

func (s *Service) Place(items []ItemInput) (Order, error) {
	if len(items) == 0 { return Order{}, errors.New("order must contain at least one item") }
	for _, item := range items {
		if item.ProductID <= 0 || item.Quantity <= 0 { return Order{}, errors.New("item productId and quantity must be positive integers") }
		if _, ok := s.catalog.Get(item.ProductID); !ok { return Order{}, product.ErrNotFound }
	}
	lines := make([]OrderLine, 0, len(items))
	total := 0.0
	for _, item := range items {
		value, err := s.catalog.Reserve(item.ProductID, item.Quantity)
		if err != nil { return Order{}, err }
		lines = append(lines, OrderLine{ProductID: value.ID, Name: value.Name, Quantity: item.Quantity, UnitPrice: value.Price})
		total += float64(item.Quantity) * value.Price
	}
	total = math.Round(total*100) / 100
	s.mu.Lock(); defer s.mu.Unlock()
	order := Order{ID: s.nextID, Lines: lines, Total: total, CreatedAt: time.Now().UTC()}
	s.nextID++
	s.orders[order.ID] = order
	return order, nil
}
