package order

import (
	"sync"
	"time"
)

// Repository gerencia a persistência dos pedidos.
type Repository struct {
	mu     sync.RWMutex
	orders []Order
}

// NewRepository inicializa o repositório em memória do módulo de pedidos.
func NewRepository() *Repository {
	return &Repository{
		orders: []Order{
			{ID: "ord-101", UserID: "usr-1", Total: 150.00, Status: "PENDING", CreatedAt: time.Now()},
			{ID: "ord-102", UserID: "usr-2", Total: 320.50, Status: "COMPLETED", CreatedAt: time.Now()},
		},
	}
}

// List retorna todos os pedidos armazenados.
func (r *Repository) List() []Order {
	r.mu.RLock()
	defer r.mu.RUnlock()
	copied := make([]Order, len(r.orders))
	copy(copied, r.orders)
	return copied
}

