package auth

import "strings"

// Service provê utilitários compartilhados de autenticação.
type Service struct{}

// New inicializa o serviço de autenticação.
func New() *Service {
	return &Service{}
}

// ValidateToken valida tokens de requisições entrantes.
func (s *Service) ValidateToken(token string) bool {
	return strings.TrimSpace(token) != ""
}

