package product

import (
	"errors"
	"math"
	"sort"
	"strings"
	"sync"
)

var (
	ErrNotFound = errors.New("product not found")
	ErrConflict = errors.New("catalog conflict")
)

type Service struct {
	mu      sync.RWMutex
	products map[int]Product
	nextID  int
}

func NewService() *Service {
	return &Service{products: map[int]Product{
		1: {ID: 1, SKU: "KB-01", Name: "Teclado Mecânico", Price: 450, Stock: 10},
		2: {ID: 2, SKU: "MS-01", Name: "Mouse Ergonômico", Price: 189.9, Stock: 25},
	}, nextID: 3}
}

func (s *Service) List() []Product {
	s.mu.RLock(); defer s.mu.RUnlock()
	products := make([]Product, 0, len(s.products))
	for _, value := range s.products { products = append(products, value) }
	sort.Slice(products, func(i, j int) bool { return products[i].ID < products[j].ID })
	return products
}

func (s *Service) Get(id int) (Product, bool) {
	s.mu.RLock(); defer s.mu.RUnlock()
	value, ok := s.products[id]
	return value, ok
}

func (s *Service) Create(sku, name string, price float64, stock int) (Product, error) {
	sku, name = strings.ToUpper(strings.TrimSpace(sku)), strings.TrimSpace(name)
	if sku == "" || name == "" || price <= 0 || math.IsNaN(price) || math.IsInf(price, 0) || stock < 0 {
		return Product{}, errors.New("sku, name, positive price, and non-negative stock are required")
	}
	s.mu.Lock(); defer s.mu.Unlock()
	for _, value := range s.products { if value.SKU == sku { return Product{}, ErrConflict } }
	value := Product{ID: s.nextID, SKU: sku, Name: name, Price: math.Round(price*100)/100, Stock: stock}
	s.nextID++
	s.products[value.ID] = value
	return value, nil
}

func (s *Service) Reserve(id, quantity int) (Product, error) {
	s.mu.Lock(); defer s.mu.Unlock()
	value, ok := s.products[id]
	if !ok { return Product{}, ErrNotFound }
	if quantity <= 0 || value.Stock < quantity { return Product{}, ErrConflict }
	value.Stock -= quantity
	s.products[id] = value
	return value, nil
}