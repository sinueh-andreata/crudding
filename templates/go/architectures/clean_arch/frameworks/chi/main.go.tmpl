package main

import (
	"encoding/json"
	"log"
	"net/http"

	"github.com/go-chi/chi/v5"

	"{{.GoModule}}/internal/application"
	infraHttp "{{.GoModule}}/internal/infrastructure/http"
	"{{.GoModule}}/internal/infrastructure/messaging"
	"{{.GoModule}}/internal/infrastructure/persistence"
)

func main() {
	repo := persistence.New()
	producer := messaging.NewProducer()
	useCase := application.NewCreateOrderUseCase(repo)
	handler := infraHttp.NewOrderHandler(useCase)

	producer.Publish("system.boot", "API iniciada com sucesso")

	router := chi.NewRouter()

	router.Get("/orders", func(w http.ResponseWriter, _ *http.Request) {
		orders, err := handler.ListOrders()
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}

		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]any{
			"architecture": "Clean Architecture (Chi)",
			"orders":       orders,
		})
	})

	log.Println("API Clean Architecture rodando em http://localhost:8080/orders")
	log.Fatal(http.ListenAndServe(":8080", router))
}

