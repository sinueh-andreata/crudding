package persistence

import (
	"sort"
	"sync"

	"{{.GoModule}}/internal/domain"
)

// InMemoryOrderRepository implementa a porta ports.OrderRepository.
type InMemoryOrderRepository struct {
	mu     sync.RWMutex
	orders map[string]domain.Order
}

// New cria o repositório em memória com dados iniciais.
func New() *InMemoryOrderRepository {
	return &InMemoryOrderRepository{orders: make(map[string]domain.Order)}
}

// Save persiste um pedido.
func (r *InMemoryOrderRepository) Save(order *domain.Order) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	copy := *order
	copy.Items = append([]domain.OrderItem(nil), order.Items...)
	r.orders[order.ID] = copy
	return nil
}

// FindAll retorna a lista de pedidos.
func (r *InMemoryOrderRepository) FindAll() ([]domain.Order, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	copied := make([]domain.Order, 0, len(r.orders))
	for _, order := range r.orders {
		order.Items = append([]domain.OrderItem(nil), order.Items...)
		copied = append(copied, order)
	}
	sort.Slice(copied, func(i, j int) bool {
		if copied[i].CreatedAt.Equal(copied[j].CreatedAt) {
			return copied[i].ID < copied[j].ID
		}
		return copied[i].CreatedAt.Before(copied[j].CreatedAt)
	})
	return copied, nil
}

func (r *InMemoryOrderRepository) FindByID(id string) (*domain.Order, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	order, ok := r.orders[id]
	if !ok {
		return nil, nil
	}
	order.Items = append([]domain.OrderItem(nil), order.Items...)
	return &order, nil
}

