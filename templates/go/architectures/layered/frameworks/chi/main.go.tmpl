package main

import (
	"encoding/json"
	"log"
	"net/http"

	"github.com/go-chi/chi/v5"

	"{{.GoModule}}/internal/handlers"
	"{{.GoModule}}/internal/repositories"
	"{{.GoModule}}/internal/services"
)

func main() {
	repo := repositories.NewItemRepository()
	service := services.NewItemService(repo)
	handler := handlers.NewItemHandler(service)

	router := chi.NewRouter()

	router.Get("/items", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]any{
			"message": "Hello from Layered Architecture (Chi)",
			"items":   handler.GetItems(),
		})
	})

	log.Println("API rodando em http://localhost:8080/items")
	log.Fatal(http.ListenAndServe(":8080", router))
}

