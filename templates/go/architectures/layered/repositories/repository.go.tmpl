package repositories

import (
	"sync"

	"{{.GoModule}}/internal/models"
)

// ItemRepository gerencia o armazenamento e recuperação de dados.
type ItemRepository struct {
	mu    sync.RWMutex
	items []models.Item
}

// NewItemRepository cria uma nova instância do repositório em memória.
func NewItemRepository() *ItemRepository {
	return &ItemRepository{
		items: []models.Item{
			{ID: "1", Title: "Notebook Gamer", Description: "16GB RAM, RTX 4060", Price: 4999.00},
			{ID: "2", Title: "Monitor UltraWide", Description: "34 polegadas 144Hz", Price: 2199.90},
		},
	}
}

// FindAll retorna a lista de todos os itens cadastrados.
func (r *ItemRepository) FindAll() []models.Item {
	r.mu.RLock()
	defer r.mu.RUnlock()
	copied := make([]models.Item, len(r.items))
	copy(copied, r.items)
	return copied
}

