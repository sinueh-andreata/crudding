package handlers

import (
	"encoding/json"
	"errors"
	"net/http"
	"strconv"
	"strings"

	"{{.GoModule}}/internal/models"
	"{{.GoModule}}/internal/services"
)

type Handler struct { service *services.Service }

func NewHandler(service *services.Service) *Handler { return &Handler{service: service} }

func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	parts := strings.Split(strings.Trim(r.URL.Path, "/"), "/")
	write := func(status int, value any) { w.Header().Set("Content-Type", "application/json"); w.WriteHeader(status); if value != nil { _ = json.NewEncoder(w).Encode(value) } }
	id := func() (int, bool) { value, err := strconv.Atoi(parts[1]); return value, err == nil && value > 0 }
	switch {
	case r.Method == http.MethodGet && len(parts) == 1 && parts[0] == "users":
		write(http.StatusOK, h.service.ListUsers())
	case r.Method == http.MethodPost && len(parts) == 1 && parts[0] == "users":
		var input struct { Name string `json:"name"`; Email string `json:"email"` }
		if json.NewDecoder(r.Body).Decode(&input) != nil { write(http.StatusBadRequest, map[string]string{"error":"invalid JSON"}); return }
		user, err := h.service.CreateUser(input.Name, input.Email)
		if err != nil { status := http.StatusBadRequest; if errors.Is(err, services.ErrConflict) { status = http.StatusConflict }; write(status, map[string]string{"error":err.Error()}); return }
		write(http.StatusCreated, user)
	case r.Method == http.MethodGet && len(parts) == 2 && parts[0] == "users":
		value, ok := id(); if !ok { write(http.StatusBadRequest, map[string]string{"error":"id is invalid"}); return }
		user, found := h.service.GetUser(value); if !found { write(http.StatusNotFound, map[string]string{"error":"user not found"}); return }; write(http.StatusOK, user)
	case r.Method == http.MethodGet && len(parts) == 1 && parts[0] == "orders":
		var userID *int
		if raw := r.URL.Query().Get("userId"); raw != "" { value, err := strconv.Atoi(raw); if err != nil || value <= 0 { write(http.StatusBadRequest, map[string]string{"error":"userId is invalid"}); return }; userID = &value }
		write(http.StatusOK, h.service.ListOrders(userID))
	case r.Method == http.MethodPost && len(parts) == 1 && parts[0] == "orders":
		var input struct { UserID int `json:"userId"`; Items []models.OrderItem `json:"items"` }
		if json.NewDecoder(r.Body).Decode(&input) != nil { write(http.StatusBadRequest, map[string]string{"error":"invalid JSON"}); return }
		order, err := h.service.CreateOrder(input.UserID, input.Items)
		if err != nil { status := http.StatusBadRequest; if errors.Is(err, services.ErrUserNotFound) { status = http.StatusNotFound }; write(status, map[string]string{"error":err.Error()}); return }
		write(http.StatusCreated, order)
	case r.Method == http.MethodGet && len(parts) == 2 && parts[0] == "orders":
		value, ok := id(); if !ok { write(http.StatusBadRequest, map[string]string{"error":"id is invalid"}); return }
		order, found := h.service.GetOrder(value); if !found { write(http.StatusNotFound, map[string]string{"error":"order not found"}); return }; write(http.StatusOK, order)
	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "orders":
		value, ok := id(); if !ok { write(http.StatusBadRequest, map[string]string{"error":"id is invalid"}); return }
		status := ""; if parts[2] == "pay" { status = "paid" }; if parts[2] == "cancel" { status = "cancelled" }; if status == "" { http.NotFound(w, r); return }
		order, err := h.service.ChangeOrderStatus(value, status); if err != nil { code := http.StatusNotFound; if errors.Is(err, services.ErrConflict) { code = http.StatusConflict }; write(code, map[string]string{"error":err.Error()}); return }; write(http.StatusOK, order)
	default:
		write(http.StatusNotFound, map[string]string{"error":"route not found"})
	}
}


