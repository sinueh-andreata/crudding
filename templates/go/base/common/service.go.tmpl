func (s *{{.VarName}}Service) Create(req {{if eq .Architecture "layered"}}types.{{end}}Create{{.Class}}Request) ({{if eq .Architecture "layered"}}types.{{end}}{{.Class}}Response, error) {
	s.mu.Lock()
	defer s.mu.Unlock()

	item := {{if eq .Architecture "layered"}}models.{{end}}{{.Class}}{
		ID:        s.nextID,
		Name:      req.Name,
{{if eq .Class "User"}}		Email:     req.Email,
		Password:  req.Password,
{{end}}		CreatedAt: time.Now().UTC(),
	}
	s.nextID++
	s.items[item.ID] = item

	return {{if eq .Architecture "layered"}}types.{{end}}{{.Class}}Response{
		ID:    item.ID,
		Name:  item.Name,
{{if eq .Class "User"}}		Email: item.Email,
{{end}}	}, nil
}

