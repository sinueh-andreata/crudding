	s.mu.RLock()
	defer s.mu.RUnlock()

	res := make([]{{if eq .Architecture "layered"}}types.{{end}}{{.Class}}Response, 0, len(s.items))
	for _, item := range s.items {
		res = append(res, {{if eq .Architecture "layered"}}types.{{end}}{{.Class}}Response{
			ID:    item.ID,
			Name:  item.Name,
{{if eq .Class "User"}}			Email: item.Email,
{{end}}		})
	}
	return res, nil
}

func (s *{{.VarName}}Service) GetByID(id uint) ({{if eq .Architecture "layered"}}types.{{end}}{{.Class}}Response, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()

	item, exists := s.items[id]
	if !exists {
		return {{if eq .Architecture "layered"}}types.{{end}}{{.Class}}Response{}, Err{{if not (eq .Architecture "modular")}}{{.Class}}{{end}}NotFound
	}

	return {{if eq .Architecture "layered"}}types.{{end}}{{.Class}}Response{
		ID:    item.ID,
		Name:  item.Name,
{{if eq .Class "User"}}		Email: item.Email,
{{end}}	}, nil
}

func (s *{{.VarName}}Service) Delete(id uint) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	if _, exists := s.items[id]; !exists {
		return Err{{if not (eq .Architecture "modular")}}{{.Class}}{{end}}NotFound
	}
	delete(s.items, id)
	return nil
}
